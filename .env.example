# Environment variable names only; replace the placeholders locally.
# The backend RAG client reads the name configured in config/backend.yaml.
export OPENAI_API_KEY=your-api-key-here

# The Agent DeepSeek client reads the name configured in config/agent.yaml.
# Never put a real key in this file or commit it to Git.
export DEEPSEEK_API_KEY=your-deepseek-api-key-here
