# Copy this file to .env and fill values after each equals sign. The application
# reads .env automatically; do not use export, source, or commit real keys.

# DeepSeek generation for both Agent and RAG.
DEEPSEEK_API_KEY=

# Aliyun Model Studio / DashScope text embedding. Copy your workspace's
# OpenAI-compatible Base URL from the Model Studio console.
DASHSCOPE_API_KEY=
DASHSCOPE_API_BASE=
